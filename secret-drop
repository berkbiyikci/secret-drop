# ---------------------------------------------------------------- guard: Claude Code PreToolUse hook

PROTECTED_GLOBS = [".env", ".env.*", "*.env", ".envrc", ".netrc", ".git-credentials", ".npmrc", ".pypirc",
                   "credentials", "*.pem", "*.key", "*.p8", "*.p12", "id_rsa", "id_ecdsa", "id_ed25519"]
SAFE_SUFFIXES = (".example", ".sample", ".template", ".dist", ".defaults")
SAFE_COMMANDS = {"ls", "touch", "chmod", "stat", "test", "[", "mkdir"}
KEYCHAIN_READ = re.compile(
    r"\bsecurity\b[^;&|]*\b(?:find-(?:generic|internet)-password\b[^;&|]*\s-\w*[wg]|dump-keychain\b[^;&|]*\s-\w*d)")
GUARD_HINT = ("Do not read secret files or the keychain. Use `secret-drop list file:<path>` for names, "
              "`secret-drop ask NAME <target>` to set a value and `secret-drop run -f <file> -- <command>` to use them.")


def only_references(path: str) -> bool:
    """A file that holds nothing but keychain: references (and harmless short values) is safe to read."""
    try:
        with open(path, encoding="utf-8") as f:
            values = parse_env(f.read())
    except (OSError, UnicodeDecodeError):
        return False
    return bool(values) and all(v.startswith("keychain:") or not is_secret_like(k, v) for k, v in values.items())


def is_protected(path: str, s: Settings, registry: set[str]) -> bool:
    base = os.path.basename(path)
    real = os.path.realpath(path)
    if any(fnmatch.fnmatch(base, g) or fnmatch.fnmatch(real, g) for g in s.allow) or base.endswith(SAFE_SUFFIXES):
        return False
    hit = (real in registry or "/Library/Keychains/" in real
           or any(fnmatch.fnmatch(base, g) for g in PROTECTED_GLOBS)
           or any(fnmatch.fnmatch(base, g) or fnmatch.fnmatch(real, os.path.expanduser(g)) for g in s.protect))
    return hit and not only_references(real)


def guard_reason(event: dict, s: Settings) -> str:
    tool, data = event.get("tool_name", ""), event.get("tool_input") or {}
    cwd = event.get("cwd") or os.getcwd()
    registry = registered_files(s)
    resolve = lambda p: os.path.join(cwd, os.path.expanduser(os.path.expandvars(p)))  # noqa: E731

    if tool in ("Read", "Edit", "MultiEdit", "NotebookEdit", "NotebookRead"):
        path = data.get("file_path") or data.get("notebook_path") or ""
        if path and is_protected(resolve(path), s, registry):
            return f"{tool} on {path}"
    elif tool == "Write":
        path = resolve(data.get("file_path", ""))
        if os.path.exists(path) and is_protected(path, s, registry):
            return f"overwriting {data.get('file_path')}"
    elif tool == "apply_patch":  # Codex file edits
        for action, path in re.findall(r"^\*\*\* (Add|Update|Delete) File: (.+)$", data.get("command", ""), re.M):
            full = resolve(path.strip())
            if (action != "Add" or os.path.exists(full)) and is_protected(full, s, registry):
                return f"editing {path.strip()}"
    elif tool == "Grep":
        path, glob = data.get("path") or "", data.get("glob") or ""
        if path and os.path.isfile(resolve(path)) and is_protected(resolve(path), s, registry):
            return f"Grep in {path}"
        if glob and any(fnmatch.fnmatch(g.strip("*/"), glob) or fnmatch.fnmatch(glob, g) for g in PROTECTED_GLOBS):
            return f"Grep over {glob}"
    elif tool == "Bash":
        command = data.get("command", "")
        if KEYCHAIN_READ.search(command):
            return "reading a keychain secret with `security`"
        substitution = "$(" in command or "`" in command
        for segment in shell_segments(command):
            first = os.path.basename(segment[0])
            if first == "secret-drop" and not substitution:
                continue  # secret-drop itself never prints a value
            for i, token in enumerate(segment):
                if first == "cp" and i == len(segment) - 1:
                    continue  # `cp .env.example .env` creates the file without reading it
                for piece in {token, token.split("=", 1)[-1], token.split(":", 1)[-1]}:
                    piece = piece.strip("\"'")
                    path = resolve(piece) if piece else ""
                    looks_like_path = "/" in piece or (piece and os.path.exists(path))
                    if looks_like_path and is_protected(path, s, registry) and first not in SAFE_COMMANDS:
                        return f"`{piece}` in a shell command"
    return ""


def shell_segments(command: str) -> list[list[str]]:
    """Splits a shell command into simple commands at ; && || | & ( ) and newlines."""
    segments: list[list[str]] = []
    for line in command.splitlines():
        lexer = shlex.shlex(line, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        try:
            tokens = list(lexer)
        except ValueError:
            tokens = line.split()
        segment: list[str] = []
        for token in tokens:
            if token and set(token) <= set(";&|()"):
                segments.append(segment)
                segment = []
            elif not set(token) <= set("<>&0123456789"):  # drop redirection operators like 2>&1
                segment.append(token)
        segments.append(segment)
    return [seg for seg in segments if seg]


def cmd_guard(_: argparse.Namespace, s: Settings) -> int:
    try:
        reason = guard_reason(json.load(sys.stdin), s)
    except Exception as e:  # a broken guard must never wedge the agent
        print(f"secret-drop guard: {e}", file=sys.stderr)
        return 0
    if reason:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": f"secret-drop guard blocked {reason}: it may expose a secret. {GUARD_HINT}",
        }}))
    return 0


# ---------------------------------------------------------------- install: PATH, skill, guard hook

CLAUDE_MATCHER = "Bash|Read|Edit|MultiEdit|Write|Grep|NotebookEdit"
CODEX_MATCHER = "Bash|apply_patch"


def is_guard_group(group: dict) -> bool:
    return any("secret-drop" in h.get("command", "") and h.get("command", "").endswith(" guard")
               for h in group.get("hooks", []))


def install_plan() -> list[tuple[str, callable]]:
    """Every change install makes, as (description, action) pairs, so it can be shown before it runs."""
    home = os.path.expanduser("~")
    script = os.path.realpath(__file__)
    repo = os.path.dirname(script)
    skill = os.path.join(repo, "skills", "secret-drop")
    guard_command = f"{shlex.quote(script)} guard"
    plan: list[tuple[str, callable]] = []

    def link(src: str, dst: str) -> None:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if os.path.islink(dst):
            os.unlink(dst)
        os.symlink(src, dst)

    def add_hook(path: str, matcher: str) -> None:
        try:
            with open(path, encoding="utf-8") as f:
                config = json.load(f)
            shutil.copy2(path, f"{path}.secret-drop-backup")
        except FileNotFoundError:
            config = {}
        groups = config.setdefault("hooks", {}).setdefault("PreToolUse", [])
        groups[:] = [g for g in groups if not is_guard_group(g)]
        groups.append({"matcher": matcher, "hooks": [{"type": "command", "command": guard_command, "timeout": 10}]})
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2)
            f.write("\n")

    bin_link = os.path.join(home, ".local", "bin", "secret-drop")
    if os.path.realpath(bin_link) != script:
        plan.append((f"link {bin_link} → {script}", lambda: link(script, bin_link)))
    rc = os.path.join(home, ".zshrc" if os.environ.get("SHELL", "").endswith("zsh") else ".bashrc")
    line = 'export PATH="$HOME/.local/bin:$PATH"'
    try:
        with open(rc, encoding="utf-8") as f:
            has_line = line in f.read()
    except FileNotFoundError:
        has_line = False
    if os.path.join(home, ".local", "bin") not in os.environ.get("PATH", "").split(os.pathsep) and not has_line:

        def add_path() -> None:
            with open(rc, "a", encoding="utf-8") as f:
                f.write(f"\n# secret-drop\n{line}\n")
        plan.append((f"add {line!r} to {rc}", add_path))
    for agent, matcher, hooks_file in (("claude", CLAUDE_MATCHER, "settings.json"), ("codex", CODEX_MATCHER, "hooks.json")):
        base = os.path.join(home, f".{agent}")
        if not os.path.isdir(base):
            continue
        skill_link = os.path.join(base, "skills", "secret-drop")
        if os.path.realpath(skill_link) != skill:
            plan.append((f"link {skill_link} → {skill} (agent skill)", lambda s=skill, d=skill_link: link(s, d)))
        hooks_path = os.path.join(base, hooks_file)
        plan.append((f"add the secret-drop guard PreToolUse hook to {hooks_path} (backup kept)",
                     lambda p=hooks_path, m=matcher: add_hook(p, m)))
    return plan


def cmd_install(args: argparse.Namespace, s: Settings) -> None:
    plan = install_plan()
    print(s.t("install_plan"))
    for description, _ in plan:
        print(f"  • {description}")
    if not args.yes:
        try:
            answer = input(s.t("install_confirm"))
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("y", "yes", "e", "evet"):
            raise Fail(s.t("install_aborted"))
    for _, action in plan:
        action()
    print(s.t("install_done"))
    if os.path.isdir(os.path.expanduser("~/.codex")):
        print("Codex: open /hooks once and trust the secret-drop guard.")


def cmd_uninstall(_: argparse.Namespace, s: Settings) -> None:
    home = os.path.expanduser("~")
    repo = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(home, ".local", "bin", "secret-drop"),
                 os.path.join(home, ".claude", "skills", "secret-drop"),
                 os.path.join(home, ".codex", "skills", "secret-drop")):
        if os.path.islink(path) and os.path.realpath(path).startswith(repo):
            os.unlink(path)
            print(f"removed {path}")
    for path in (os.path.join(home, ".claude", "settings.json"), os.path.join(home, ".codex", "hooks.json")):
        try:
            with open(path, encoding="utf-8") as f:
                config = json.load(f)
        except FileNotFoundError:
            continue
        groups = config.get("hooks", {}).get("PreToolUse", [])
        kept = [g for g in groups if not is_guard_group(g)]
        if len(kept) != len(groups):
            config["hooks"]["PreToolUse"] = kept
            with open(path, "w", encoding="utf-8") as f:
                json.dump(config, f, indent=2)
                f.write("\n")
            print(f"removed the guard hook from {path}")
    print(s.t("uninstall_done"))


TARGET_HELP = "file:<path> | ssh:<host>:<path> | keychain:<service> | exec:<command> | @<configured name>"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="secret-drop",
        description="Hand a secret to its destination through a native dialog, without pasting it into a chat.",
    )
    parser.add_argument("--version", action="version", version=f"secret-drop {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    ask = sub.add_parser("ask", help="ask for one secret and write it to a target")
    ask.add_argument("name", help="variable name, e.g. STRIPE_SECRET_KEY")
    ask.add_argument("target", help=TARGET_HELP)
    ask.add_argument("note", nargs="?", default="", help="hint shown in the dialog (where to find the value)")
    ask.add_argument("--then", help="shell command to run after a successful write (never sees the value)")
    ask.add_argument("--ref", metavar="FILE",
                     help="with a keychain: target, also write NAME=keychain:<service> to this env file")
    ask.set_defaults(func=cmd_ask)

    oauth = sub.add_parser("google-oauth", help="run a Google OAuth consent flow and store the refresh token")
    oauth.add_argument("prefix", help="writes <PREFIX>_CLIENT_ID, _CLIENT_SECRET and _REFRESH_TOKEN")
    oauth.add_argument("client_id")
    oauth.add_argument("scope", help="space-separated scopes, quoted")
    oauth.add_argument("target", help=TARGET_HELP)
    oauth.add_argument("--no-open", action="store_true", help="print the consent URL instead of opening it")
    oauth.add_argument("--reuse-secret", action="store_true",
                       help="read <PREFIX>_CLIENT_SECRET back from the target instead of asking")
    oauth.add_argument("--then", help="shell command to run after a successful write (never sees the values)")
    oauth.add_argument("--ref", metavar="FILE", help="with a keychain: target, also write references to this env file")
    oauth.set_defaults(func=cmd_google_oauth)

    run = sub.add_parser("run", help="run a command with secrets in its environment and scrub them from its output")
    run.add_argument("-f", "--env-file", action="append", default=[], metavar="FILE",
                     help="KEY=value file; keychain:<service> values are resolved (repeatable)")
    run.add_argument("command", nargs=argparse.REMAINDER, help="-- command [args...]")
    run.set_defaults(func=cmd_run)

    lst = sub.add_parser("list", help="list the secret names in a target (never the values)")
    lst.add_argument("target", help=TARGET_HELP)
    lst.set_defaults(func=cmd_list)

    targets = sub.add_parser("targets", help="list the targets defined in the config file")
    targets.set_defaults(func=cmd_targets)

    guard = sub.add_parser("guard", help="PreToolUse hook for Claude Code and Codex: blocks reads of secret files")
    guard.set_defaults(func=cmd_guard)

    install = sub.add_parser("install", help="put secret-drop on PATH and add the agent skill and guard hook")
    install.add_argument("--yes", action="store_true", help="don't ask for confirmation")
    install.set_defaults(func=cmd_install)

    uninstall = sub.add_parser("uninstall", help="remove what install added")
    uninstall.set_defaults(func=cmd_uninstall)

    args = parser.parse_args(argv)
    try:
        settings = load_settings()
        code = args.func(args, settings)
        if isinstance(code, int):
            return code
    except Fail as e:
        print(f"secret-drop: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
