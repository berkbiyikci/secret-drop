# ---------------------------------------------------------------- guard: Claude Code / Codex PreToolUse hook

# File names that hold secrets. The first group is matched by name alone, wherever it appears in a
# command; the second only when the path exists, because the names are also ordinary words.
SECRET_NAMES = [".env", ".env.*", "*.env", ".envrc", ".netrc", ".git-credentials", ".npmrc", ".pypirc",
                "id_rsa", "id_ecdsa", "id_ed25519", "id_dsa"]
SECRET_FILES = ["credentials", "*.pem", "*.key", "*.p8", "*.p12", "*.pfx", "*.keystore", "*.jks"]
SAFE_SUFFIXES = (".example", ".sample", ".template", ".dist", ".defaults", ".pub")
# Commands that never print a file's contents (they may still create, test, move or delete it).
SAFE_COMMANDS = {"ls", "touch", "chmod", "chown", "stat", "test", "[", "[[", "mkdir", "wc", "rm", "echo", "printf",
                 "cd", "pushd", "popd", "true", "false", ":", "which", "type", "file", "realpath", "dirname",
                 "basename", "ln"}
# Shell words to skip to find the command a segment actually runs.
PREFIX_WORDS = {"if", "then", "else", "elif", "do", "while", "until", "!", "time", "{", "}", "fi", "done", "nohup",
                "command", "builtin", "exec", "sudo"}
GREP_COMMANDS = {"grep", "egrep", "fgrep", "rg", "ag", "ack"}
KEYCHAIN_READ = re.compile(
    r"\bsecurity\b[^;&|]*\b(?:find-(?:generic|internet)-password\b[^;&|]*\s-\w*[wg]|dump-keychain\b[^;&|]*\s-\w*d)")
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1")
GUARD_HINT = ("Do not read secret files or the keychain. Use `secret-drop list file:<path>` for names, "
              "`secret-drop ask NAME <target>` to set a value and `secret-drop run -f <file> -- <command>` to use them.")


def name_matches(name: str, globs: list[str]) -> bool:
    name = name.lower()  # macOS file names are case-insensitive
    return not name.endswith(SAFE_SUFFIXES) and any(fnmatch.fnmatchcase(name, g.lower()) for g in globs)


def only_references(path: str) -> bool:
    """A file that holds nothing but keychain: references and plain configuration is safe to read."""
    try:
        with open(path, encoding="utf-8") as f:
            values = parse_env(f.read())
    except (OSError, UnicodeDecodeError, ValueError):
        return False
    return bool(values) and all(v.startswith("keychain:") or harmless(k, v) for k, v in values.items())


class Guard:
    def __init__(self, s: Settings):
        self.s = s
        self.registry = registered_files(s)

    def protected(self, path: str) -> bool:
        """Is this path (existing or not) a secret file the agent must not read?"""
        path = path.replace("\0", "")
        real = os.path.realpath(path)
        names = {os.path.basename(path), os.path.basename(real)}
        if any(fnmatch.fnmatch(real, os.path.expanduser(g)) or any(fnmatch.fnmatch(n, g) for n in names)
               for g in self.s.allow):
            return False
        if real in self.registry:
            return True
        hit = ("/Library/Keychains/" in real
               or any(name_matches(n, SECRET_NAMES) for n in names)
               or (os.path.exists(real) and any(name_matches(n, SECRET_FILES) for n in names))
               or any(fnmatch.fnmatch(real, os.path.expanduser(g)) or any(fnmatch.fnmatch(n, g) for n in names)
                      for g in self.s.protect))
        return hit and not only_references(real)

    def mentions(self, word: str, cwd: str) -> str:
        """Returns the protected path a shell word refers to, if any."""
        candidates = {word, word.split("=", 1)[-1], word.split(":", 1)[-1]}
        candidates |= set(re.findall(r"[\w./~$@{}+-]*\.env[\w.*-]*|[\w./~-]*(?:\.netrc|\.envrc|\.npmrc|"
                                     r"\.pypirc|\.git-credentials|id_rsa|id_ecdsa|id_ed25519)\b", word))
        for piece in candidates:
            piece = piece.strip("\"'()<>;,`{}[]").rstrip("*")
            if not piece or piece.startswith("-"):
                continue
            path = os.path.join(cwd, os.path.expanduser(os.path.expandvars(piece)))
            if self.protected(path):
                return piece
            if any(ch in word for ch in "*?") and name_matches(os.path.basename(piece) + ".x", [".env.*"]):
                return piece  # a glob such as .env* or .env.* reaches the real files
        return ""

    def dir_has_secrets(self, path: str, limit: int = 5000) -> bool:
        """Whether a directory tree holds a protected file (bounded walk, skips vendored folders)."""
        if not os.path.isdir(path):
            return False
        seen = 0
        for root, dirs, files in os.walk(path):
            dirs[:] = [d for d in dirs if d not in (".git", "node_modules", ".venv", "venv", "__pycache__")]
            for name in files:
                seen += 1
                if self.protected(os.path.join(root, name)):
                    return True
            if seen > limit:
                return True  # too big to check quickly; err on the safe side
        return False

    def bash(self, command: str, cwd: str, depth: int = 0) -> str:
        if depth > 3:
            return ""
        if KEYCHAIN_READ.search(command):
            return "reading a keychain secret with `security`"
        substitution = "$(" in command or "`" in command
        for inner in re.findall(r"\$\(([^()]*(?:\([^()]*\)[^()]*)*)\)|`([^`]*)`", command):
            reason = self.bash(inner[0] or inner[1], cwd, depth + 1)  # command substitutions run first
            if reason:
                return reason
        for segment in shell_segments(strip_heredocs(command)):
            while segment and segment[0] in PREFIX_WORDS:
                segment = segment[1:]
            if not segment:
                continue
            first = os.path.basename(segment[0])
            args = segment[1:]
            if first in ("cd", "pushd") and args:
                cwd = os.path.join(cwd, os.path.expanduser(os.path.expandvars(args[-1])))
                continue
            if first == "secret-drop" and not substitution:
                reason = self.secret_drop(args, cwd, depth)
                if reason:
                    return reason
                continue
            if first in SAFE_COMMANDS:
                continue
            if first in GREP_COMMANDS:
                args = drop_pattern(args)
                recursive = any(a in ("-r", "-R", "--recursive") or (a.startswith("-") and not a.startswith("--")
                                                                     and set("rR") & set(a)) for a in args)
                if first in ("grep", "egrep", "fgrep") and recursive:
                    dirs = [os.path.join(cwd, a) for a in args if not a.startswith("-")] or [cwd]
                    if any(self.dir_has_secrets(d) for d in dirs):
                        return "a recursive grep over files such as .env (use rg or the Grep tool, which skip them)"
            if first == "git":
                sub = next((a for a in args if not a.startswith("-")), "")
                if sub in ("status", "check-ignore", "ls-files", "log") or (
                        sub == "rm" and "--cached" in args):
                    continue
                if sub == "commit":
                    args = drop_option_values(args, {"-m", "--message"})
                if "-C" in args:
                    i = args.index("-C")
                    if i + 1 < len(args):
                        cwd = os.path.join(cwd, args[i + 1])
            if first in ("ssh", "scp", "sftp"):
                args = drop_option_values(args, {"-i"})
            if first in ("docker", "docker-compose"):
                args = drop_option_values(args, {"--env-file"})
            if first == "find" and not {"-exec", "-execdir", "-ok", "-okdir", "-fprint"} & set(args):
                continue
            for i, word in enumerate(args):
                if first == "cp" and i == len(args) - 1:
                    continue  # `cp .env.example .env` creates the file without reading it
                if re.search(r"\s", word):  # sh -c '…', python -c '…', awk programs
                    reason = self.bash(word, cwd, depth + 1)
                    if reason:
                        return reason
                hit = self.mentions(word, cwd)
                if hit:
                    return f"`{hit}` in a shell command"
        return ""

    def secret_drop(self, args: list[str], cwd: str, depth: int) -> str:
        """secret-drop never prints a value itself, but the commands it runs could."""
        for i, word in enumerate(args):
            if word == "--then" and i + 1 < len(args):
                reason = self.bash(args[i + 1], cwd, depth + 1)
                if reason:
                    return reason + " (in --then)"
            if word.startswith("exec:"):
                reason = self.bash(word[len("exec:"):], cwd, depth + 1)
                if reason:
                    return reason + " (in exec:)"
        if args[:1] == ["run"] and "--" in args:
            inner = args[args.index("--") + 1:]
            reason = self.bash(shlex.join(inner), cwd, depth + 1)
            if reason:
                return reason + " (inside secret-drop run)"
        return ""

    def event(self, event: dict) -> str:
        tool, data = event.get("tool_name", ""), event.get("tool_input") or {}
        cwd = event.get("cwd") or os.getcwd()
        resolve = lambda p: os.path.join(cwd, os.path.expanduser(os.path.expandvars(p)))  # noqa: E731
        if tool in ("Read", "Edit", "MultiEdit", "NotebookEdit", "NotebookRead"):
            path = data.get("file_path") or data.get("notebook_path") or ""
            if path and self.protected(resolve(path)):
                return f"{tool} on {path}"
        elif tool == "Write":
            path = resolve(data.get("file_path", ""))
            if os.path.exists(path) and self.protected(path):
                return f"overwriting {data.get('file_path')}"
        elif tool == "apply_patch":  # Codex file edits
            for action, path in re.findall(r"^\*\*\* (Add File|Update File|Delete File|Move to): (.+)$",
                                           data.get("command", ""), re.M):
                full = resolve(path.strip())
                if (action != "Add File" or os.path.exists(full)) and self.protected(full):
                    return f"editing {path.strip()}"
        elif tool == "Grep":
            path, glob = data.get("path") or "", data.get("glob") or ""
            if path and not os.path.isdir(resolve(path)) and self.protected(resolve(path)):
                return f"Grep in {path}"
            if glob and (self.mentions(glob, cwd) or name_matches(glob.split("/")[-1].rstrip("*") + "x", [".env*"])):
                return f"Grep over {glob}"
        elif tool == "Bash":
            return self.bash(data.get("command", "").replace("\0", ""), cwd)
        return ""


def strip_heredocs(command: str) -> str:
    """Removes here-document bodies (commit messages, file contents) so their text isn't read as commands."""
    lines, out, end = command.splitlines(), [], None
    for line in lines:
        if end is not None:
            if line.strip() == end:
                end = None
            continue
        out.append(line)
        m = HEREDOC.search(line)
        if m:
            end = m.group(2)
    return "\n".join(out)


def drop_option_values(args: list[str], options: set[str]) -> list[str]:
    out, skip = [], False
    for a in args:
        if skip:
            skip = False
        elif a in options:
            skip = True
        elif not any(a.startswith(o + "=") for o in options):
            out.append(a)
    return out


def drop_pattern(args: list[str]) -> list[str]:
    """grep PATTERN FILE…: the pattern is text, not a file to read."""
    out, dropped = [], False
    for a in args:
        if not dropped and not a.startswith("-"):
            dropped = True
            continue
        out.append(a)
    return out


def shell_segments(command: str) -> list[list[str]]:
    """Splits a shell command into simple commands at ; && || | & ( ) and newlines."""
    segments: list[list[str]] = []
    for line in command.splitlines():
        lexer = shlex.shlex(line, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        try:
            tokens = list(lexer)
        except ValueError:
            tokens = line.split()
        segment: list[str] = []
        for token in tokens:
            if token and set(token) <= set(";&|()"):
                segments.append(segment)
                segment = []
            elif not set(token) <= set("<>&0123456789"):  # drop redirection operators like 2>&1
                segment.append(token)
        segments.append(segment)
    return [seg for seg in segments if seg]


def cmd_guard(_: argparse.Namespace, s: Settings) -> int:
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return 0  # not a hook event
    try:
        reason = Guard(s).event(event)
    except Exception as e:  # fail closed for this one call, with a message the agent can act on
        reason = f"this call because the guard hit an error ({type(e).__name__}: {e})"
    if reason:
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": f"secret-drop guard blocked {reason}: it may expose a secret. {GUARD_HINT}",
        }}))
    return 0


# ---------------------------------------------------------------- install: PATH, skill, guard hook

CLAUDE_MATCHER = "Bash|Read|Edit|MultiEdit|Write|Grep|NotebookEdit"
CODEX_MATCHER = "Bash|apply_patch"
AGENTS = (("claude", CLAUDE_MATCHER, "settings.json"), ("codex", CODEX_MATCHER, "hooks.json"))


def is_guard_hook(hook: dict) -> bool:
    command = hook.get("command", "")
    return "secret-drop" in command and command.rstrip().endswith(" guard")


def without_guard(config: dict) -> dict:
    """Removes secret-drop guard hooks, keeping every other hook and dropping groups that end up empty."""
    groups = config.get("hooks", {}).get("PreToolUse")
    if isinstance(groups, list):
        kept = []
        for group in groups:
            hooks = [h for h in group.get("hooks", []) if not is_guard_hook(h)]
            if hooks:
                kept.append({**group, "hooks": hooks})
        config["hooks"]["PreToolUse"] = kept
    return config


def read_json(path: str) -> dict:
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    if not isinstance(data, dict):
        raise ValueError("not a JSON object")
    return data


def write_json(path: str, data: dict) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path) and not os.path.exists(path + ".secret-drop-backup"):
        shutil.copy2(path, path + ".secret-drop-backup")  # the original, kept once
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".secret-drop-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    if os.path.exists(path):
        shutil.copymode(path, tmp)
    os.replace(tmp, path)


def install_plan() -> list[tuple[str, callable]]:
    """Every change install makes, as (description, action) pairs, so it can be shown before it runs.
    Reads and validates all agent configs first, so a broken one stops the install before any change."""
    home = os.path.expanduser("~")
    script = os.path.realpath(__file__)
    skill = os.path.join(os.path.dirname(script), "skills", "secret-drop")
    guard_command = f"{shlex.quote(script)} guard"
    plan: list[tuple[str, callable]] = []

    def link(src: str, dst: str) -> None:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if os.path.islink(dst):
            os.unlink(dst)
        os.symlink(src, dst)

    bin_link = os.path.join(home, ".local", "bin", "secret-drop")
    if os.path.realpath(bin_link) != script:
        if os.path.exists(bin_link) and not os.path.islink(bin_link):
            raise Fail(f"{bin_link} exists and is not a link; move it away first")
        plan.append((f"link {bin_link} → {script}", lambda: link(script, bin_link)))
    rc = os.path.join(home, ".zshrc" if os.environ.get("SHELL", "").endswith("zsh") else ".bashrc")
    line = 'export PATH="$HOME/.local/bin:$PATH"'
    try:
        with open(rc, encoding="utf-8") as f:
            has_line = line in f.read()
    except FileNotFoundError:
        has_line = False
    if os.path.join(home, ".local", "bin") not in os.environ.get("PATH", "").split(os.pathsep) and not has_line:
        def add_path() -> None:
            with open(rc, "a", encoding="utf-8") as f:
                f.write(f"\n# secret-drop\n{line}\n")
        plan.append((f"add {line!r} to {rc}", add_path))

    for agent, matcher, hooks_file in AGENTS:
        base = os.path.join(home, f".{agent}")
        if not os.path.isdir(base):
            continue
        skill_link = os.path.join(base, "skills", "secret-drop")
        if os.path.realpath(skill_link) != skill:
            if os.path.exists(skill_link) and not os.path.islink(skill_link):
                raise Fail(f"{skill_link} exists and is not a link; move it away first")
            plan.append((f"link {skill_link} → {skill} (agent skill)", lambda s=skill, d=skill_link: link(s, d)))
        hooks_path = os.path.join(base, hooks_file)
        try:
            config = without_guard(read_json(hooks_path))
        except ValueError as e:
            raise Fail(f"{hooks_path} is not valid JSON ({e}); fix it first, nothing was changed") from None
        config.setdefault("hooks", {}).setdefault("PreToolUse", []).append(
            {"matcher": matcher, "hooks": [{"type": "command", "command": guard_command, "timeout": 10}]})
        plan.append((f"add the guard PreToolUse hook to {hooks_path} (other hooks kept, original backed up once)",
                     lambda p=hooks_path, c=config: write_json(p, c)))
    return plan


def cmd_install(args: argparse.Namespace, s: Settings) -> None:
    plan = install_plan()
    print(s.t("install_plan"))
    for description, _ in plan:
        print(f"  • {description}")
    if not args.yes:
        try:
            answer = input(s.t("install_confirm"))
        except EOFError:
            answer = ""
        if answer.strip().lower() not in ("y", "yes", "e", "evet"):
            raise Fail(s.t("install_aborted"), 1)
    for _, action in plan:
        action()
    print(s.t("install_done"))
    if os.path.isdir(os.path.expanduser("~/.codex")):
        print("Codex: open /hooks once and trust the secret-drop guard.")


def cmd_uninstall(_: argparse.Namespace, s: Settings) -> None:
    home = os.path.expanduser("~")
    repo = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(home, ".local", "bin", "secret-drop"),
                 *(os.path.join(home, f".{agent}", "skills", "secret-drop") for agent, _, _ in AGENTS)):
        if os.path.islink(path) and os.path.realpath(path).startswith(repo):
            os.unlink(path)
            print(f"removed {path}")
    for agent, _, hooks_file in AGENTS:
        path = os.path.join(home, f".{agent}", hooks_file)
        try:
            config = read_json(path)
        except ValueError:
            print(f"skipped {path}: not valid JSON")
            continue
        before = json.dumps(config, sort_keys=True)
        if config and json.dumps(without_guard(config), sort_keys=True) != before:
            write_json(path, config)
            print(f"removed the guard hook from {path}")
    print(s.t("uninstall_done"))


TARGET_HELP = "file:<path> | ssh:<host>:<path> | keychain:<service> | exec:<command> | @<configured name>"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="secret-drop",
        description="Hand a secret to its destination through a native dialog, without pasting it into a chat.",
    )
    parser.add_argument("--version", action="version", version=f"secret-drop {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    ask = sub.add_parser("ask", help="ask for one secret and write it to a target")
    ask.add_argument("name", help="variable name, e.g. STRIPE_SECRET_KEY")
    ask.add_argument("target", help=TARGET_HELP)
    ask.add_argument("note", nargs="?", default="", help="hint shown in the dialog (where to find the value)")
    ask.add_argument("--then", help="shell command to run after a successful write (not given the value; output scrubbed)")
    ask.add_argument("--ref", metavar="FILE",
                     help="with a keychain: target, also write NAME=keychain:<service> to this env file")
    ask.set_defaults(func=cmd_ask)

    oauth = sub.add_parser("google-oauth", help="run a Google OAuth consent flow and store the refresh token")
    oauth.add_argument("prefix", help="writes <PREFIX>_CLIENT_ID, _CLIENT_SECRET and _REFRESH_TOKEN")
    oauth.add_argument("client_id")
    oauth.add_argument("scope", help="space-separated scopes, quoted")
    oauth.add_argument("target", help=TARGET_HELP)
    oauth.add_argument("--no-open", action="store_true", help="print the consent URL instead of opening it")
    oauth.add_argument("--reuse-secret", action="store_true",
                       help="read <PREFIX>_CLIENT_SECRET back from the target instead of asking")
    oauth.add_argument("--then", help="shell command to run after a successful write (not given the values; output scrubbed)")
    oauth.add_argument("--ref", metavar="FILE", help="with a keychain: target, also write references to this env file")
    oauth.set_defaults(func=cmd_google_oauth)

    run = sub.add_parser("run", help="run a command with secrets in its environment and scrub them from its output")
    run.add_argument("-f", "--env-file", action="append", default=[], metavar="FILE",
                     help="KEY=value file; keychain:<service> values are resolved (repeatable)")
    run.add_argument("command", nargs=argparse.REMAINDER, help="-- command [args...]")
    run.set_defaults(func=cmd_run)

    lst = sub.add_parser("list", help="list the secret names in a target (never the values)")
    lst.add_argument("target", help=TARGET_HELP)
    lst.set_defaults(func=cmd_list)

    targets = sub.add_parser("targets", help="list the targets defined in the config file")
    targets.set_defaults(func=cmd_targets)

    guard = sub.add_parser("guard", help="PreToolUse hook for Claude Code and Codex: blocks reads of secret files")
    guard.set_defaults(func=cmd_guard)

    install = sub.add_parser("install", help="put secret-drop on PATH and add the agent skill and guard hook")
    install.add_argument("--yes", action="store_true", help="don't ask for confirmation")
    install.set_defaults(func=cmd_install)

    uninstall = sub.add_parser("uninstall", help="remove what install added")
    uninstall.set_defaults(func=cmd_uninstall)

    args = parser.parse_args(argv)
    try:
        try:
            settings = load_settings()
        except (configparser.Error, ValueError) as e:
            if args.func is not cmd_guard:
                raise Fail(f"config: {e}", 2) from None
            settings = Settings("en", DEFAULT_TIMEOUT, None, config_path(), {}, [], [])  # keep guarding
        code = args.func(args, settings)
        if isinstance(code, int):
            return code
    except Fail as e:
        print(f"secret-drop: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
