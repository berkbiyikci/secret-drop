def prompt_secret(name: str, text: str, s: Settings) -> str:
    title, timeout = s.t("title"), s.timeout
    try:
        if s.prompter:
            env = {**os.environ, "SECRET_DROP_NAME": name, "SECRET_DROP_PROMPT": text}
            out = subprocess.run(s.prompter, shell=True, env=env, capture_output=True, text=True, timeout=timeout)
        elif shutil.which("osascript"):
            args = ["osascript", "-", text, title, s.t("cancel"), s.t("save"), str(timeout)]
            out = subprocess.run(args, input=OSASCRIPT, capture_output=True, text=True, timeout=timeout + 30)
        elif shutil.which("zenity"):
            args = ["zenity", "--entry", "--hide-text", "--title", title, "--text", text, "--timeout", str(timeout)]
            out = subprocess.run(args, capture_output=True, text=True, timeout=timeout + 30)
        elif shutil.which("kdialog"):
            args = ["kdialog", "--title", title, "--password", text]
            out = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        else:
            raise Fail(s.t("no_prompter"))
    except subprocess.TimeoutExpired:
        return ""
    if out.returncode != 0:
        error = out.stderr.strip()
        # Cancel: osascript reports -128; zenity, kdialog and custom prompters exit 1 (zenity 5 on timeout).
        uses_osascript = not s.prompter and shutil.which("osascript")
        if ("-128" in error) if uses_osascript else out.returncode in (1, 5):
            return ""
        raise Fail(s.t("dialog_failed", error=error.splitlines()[-1] if error else f"exit {out.returncode}"), 3)
    value = out.stdout.strip()
    if any(c in value for c in "\r\n\x00"):
        raise Fail(s.t("multiline"))
    return value


# ---------------------------------------------------------------- commands


def with_ref(target: Target, ref: str | None, s: Settings) -> Target:
    if ref:
        target.ref = os.path.expanduser(ref)
    if target.ref and target.kind != "keychain":
        raise Fail(s.t("ref_needs_keychain"), 2)
    return target


def cmd_ask(args: argparse.Namespace, s: Settings) -> None:
    check_name(args.name, s)
    target = with_ref(resolve_target(args.target, s), args.ref, s)
    preflight(target, s)
    text = s.t("paste", name=args.name) + (f"\n\n{args.note}" if args.note else "")
    value = prompt_secret(args.name, text, s)
    if not value:
        raise Fail(s.t("cancelled"))
    label, notes = deliver(target, {args.name: value}, s)
    extra = s.t("clipboard") if clear_clipboard([value]) else ""
    print(s.t("written", name=args.name, target=label, length=len(value), extra=extra), flush=True)
    for note in notes:
        print(note, flush=True)
    run_then(target, args.then, [args.name], s)


def consent(client_id: str, client_secret: str, scope: str, open_browser: bool, s: Settings) -> dict:
    state = secrets.token_urlsafe(24)
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    result: dict[str, str] = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802
            url = urllib.parse.urlparse(self.path)
            query = {k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()}
            if url.path != "/" or not secrets.compare_digest(query.get("state", ""), state):
                self.send_response(404)
                self.end_headers()
                return
            result.update(query)
            ok = "code" in result
            body = (s.t("consent_ok") if ok else s.t("consent_failed", error=result.get("error", "?"))).encode()
            self.send_response(200)
            self.send_header("content-type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_):
            pass

    # Binding port 0 directly avoids the race of picking a free port and binding it later.
    with http.server.HTTPServer(("127.0.0.1", 0), Handler) as server:
        redirect = f"http://127.0.0.1:{server.server_address[1]}"
        url = GOOGLE_AUTH_URL + "?" + urllib.parse.urlencode({
            "client_id": client_id,
            "redirect_uri": redirect,
            "response_type": "code",
            "scope": scope,
            "access_type": "offline",
            "prompt": "consent select_account",
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
        })
        if open_browser:
            print(s.t("browser"), flush=True)
            webbrowser.open(url)
        else:
            print(s.t("auth_url_hint"), flush=True)
            print(f"AUTH_URL {url}", flush=True)
        deadline = time.monotonic() + s.timeout
        while "code" not in result and "error" not in result:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise Fail(s.t("oauth_timeout"))
            server.timeout = remaining
            server.handle_request()
    if "code" not in result:
        raise Fail(s.t("oauth_denied", error=result.get("error")))

    data = urllib.parse.urlencode({
        "code": result["code"],
        "client_id": client_id,
        "client_secret": client_secret,
        "redirect_uri": redirect,
        "grant_type": "authorization_code",
        "code_verifier": verifier,
    }).encode()
    try:
        with urllib.request.urlopen(GOOGLE_TOKEN_URL, data=data, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            error = json.load(e).get("error", e.code)
        except ValueError:
            error = e.code
        raise Fail(s.t("token_error", error=error)) from None


