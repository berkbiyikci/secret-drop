class Fail(Exception):
    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


@dataclass
class Settings:
    lang: str
    timeout: int
    prompter: str | None
    config_path: str
    aliases: dict[str, dict[str, str]]

    def t(self, key: str, **kw) -> str:
        return MESSAGES[self.lang][key].format(**kw)


@dataclass
class Target:
    label: str  # what the user typed, shown in output
    kind: str  # file | ssh | keychain | exec
    location: str  # path, remote path, keychain service or shell command
    host: str = ""
    then: str = ""


# ---------------------------------------------------------------- settings


def detect_lang(configured: str | None) -> str:
    for candidate in (os.environ.get("SECRET_DROP_LANG"), configured,
                      os.environ.get("LC_ALL"), os.environ.get("LC_MESSAGES"), os.environ.get("LANG")):
        if candidate:
            return "tr" if candidate.lower().startswith("tr") else "en"
    if sys.platform == "darwin":
        out = subprocess.run(["defaults", "read", "-g", "AppleLanguages"], capture_output=True, text=True)
        first = re.search(r'"?([A-Za-z-]+)"?', out.stdout.split("(", 1)[-1])
        if first and first.group(1).lower().startswith("tr"):
            return "tr"
    return "en"


def load_settings() -> Settings:
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    path = os.environ.get("SECRET_DROP_CONFIG") or os.path.join(config_home, "secret-drop", "config")
    parser = configparser.ConfigParser(interpolation=None)
    parser.read(path, encoding="utf-8")
    base = parser["settings"] if parser.has_section("settings") else {}
    aliases = {
        section.split(".", 1)[1]: dict(parser[section])
        for section in parser.sections()
        if section.startswith("target.")
    }
    timeout = int(os.environ.get("SECRET_DROP_TIMEOUT") or base.get("timeout") or DEFAULT_TIMEOUT)
    prompter = os.environ.get("SECRET_DROP_PROMPTER") or base.get("prompter") or None
    return Settings(detect_lang(base.get("lang")), timeout, prompter, path, aliases)


# ---------------------------------------------------------------- targets


def check_name(name: str, s: Settings) -> None:
    if not NAME_RE.match(name):
        raise Fail(s.t("bad_name", name=name), 2)


def resolve_target(spec: str, s: Settings) -> Target:
    alias = spec[1:] if spec.startswith("@") else (spec if ":" not in spec else None)
    if alias is not None:
        if alias not in s.aliases or "target" not in s.aliases[alias]:
            raise Fail(s.t("unknown_target", target=spec), 2)
        conf = s.aliases[alias]
        inner = resolve_target(conf["target"], s)
        return Target(f"@{alias}", inner.kind, inner.location, inner.host, conf.get("then", ""))
    kind, _, rest = spec.partition(":")
    if kind == "ssh":
        host, sep, path = rest.partition(":")
        if host and sep and path:
            return Target(spec, "ssh", path, host)
    elif kind in ("file", "keychain", "exec") and rest:
        location = os.path.expanduser(rest) if kind == "file" else rest
        return Target(spec, kind, location)
    raise Fail(s.t("unknown_target", target=spec), 2)


def preflight(target: Target, s: Settings) -> None:
    """Fail before the dialog opens, so nobody pastes a secret into a dead end."""
    if target.kind == "file":
        parent = os.path.dirname(os.path.abspath(target.location))
        if not os.path.isdir(parent):
            raise Fail(s.t("no_dir", path=parent))
    elif target.kind == "keychain" and sys.platform != "darwin":
        raise Fail(s.t("keychain_macos"))
    elif target.kind == "ssh":
        ssh(target.host, "true", s)


def ssh(host: str, script: str, s: Settings, stdin: str = "") -> str:
    out = subprocess.run([*SSH, host, script], input=stdin, capture_output=True, text=True)
    if out.returncode != 0:
        sys.stderr.write(out.stderr)
        raise Fail(s.t("ssh_failed", host=host, code=out.returncode))
    return out.stdout


def remote_path(path: str) -> str:
    if path.startswith("~/"):
        return '"$HOME"/' + shlex.quote(path[2:])
    return shlex.quote(path)


def write_values(target: Target, values: dict[str, str], s: Settings) -> None:
    if target.kind == "file":
        write_env_file(target.location, values)
    elif target.kind == "ssh":
        names = "|".join(values)  # names are validated, safe inside the pattern
        script = (
            f"set -eu; umask 077; f={remote_path(target.location)}; "
            'new=$(mktemp "$f.secret-drop.XXXXXX"); trap \'rm -f "$new"\' EXIT; '
            f"if [ -f \"$f\" ]; then grep -v -E '^({names})=' \"$f\" > \"$new\" || [ $? -eq 1 ]; fi; "
            'cat >> "$new"; chmod 600 "$new"; mv "$new" "$f"; trap - EXIT'
        )
        ssh(target.host, script, s, stdin="".join(f"{k}={v}\n" for k, v in values.items()))
    elif target.kind == "keychain":
        for name, value in values.items():
            # `security -i` reads the command from stdin, so the value never reaches argv.
            command = f"add-generic-password -U -s {shlex.quote(target.location)} -a {name} -X {value.encode().hex()}\n"
            subprocess.run(["security", "-i"], input=command, capture_output=True, text=True)
            check = subprocess.run(["security", "find-generic-password", "-s", target.location, "-a", name],
                                   capture_output=True)
            if check.returncode != 0:
                raise Fail(s.t("keychain_failed", name=name))
    elif target.kind == "exec":
        for name, value in values.items():
            env = {**os.environ, "SECRET_DROP_NAME": name}
            # stdout is discarded so a careless command cannot echo the value back to the agent.
            out = subprocess.run(target.location, shell=True, input=value, env=env, text=True,
                                 stdout=subprocess.DEVNULL)
            if out.returncode != 0:
                raise Fail(s.t("exec_failed", name=name, code=out.returncode))


def write_env_file(path: str, values: dict[str, str]) -> None:
    path = os.path.realpath(path)
    try:
        with open(path, encoding="utf-8") as f:
            lines = [line for line in f.read().splitlines() if line.split("=", 1)[0] not in values]
    except FileNotFoundError:
        lines = []
    lines += [f"{k}={v}" for k, v in values.items()]
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".secret-drop-")  # created 0600
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def read_value(target: Target, name: str, s: Settings) -> str:
    if target.kind == "file":
        try:
            with open(target.location, encoding="utf-8") as f:
                found = [line.split("=", 1)[1] for line in f.read().splitlines() if line.startswith(f"{name}=")]
        except FileNotFoundError:
            found = []
        return found[-1] if found else ""
    if target.kind == "ssh":
        script = f"[ -f {remote_path(target.location)} ] && sed -n 's/^{name}=//p' {remote_path(target.location)} | tail -n 1 || true"
        return ssh(target.host, script, s).strip()
    if target.kind == "keychain":
        out = subprocess.run(["security", "find-generic-password", "-s", target.location, "-a", name, "-w"],
                             capture_output=True, text=True)
        return out.stdout.strip() if out.returncode == 0 else ""
    raise Fail(s.t("reuse_unsupported"), 2)


def run_then(target: Target, extra: str | None, names: list[str], s: Settings) -> None:
    env = {**os.environ, "SECRET_DROP_NAMES": " ".join(names), "SECRET_DROP_TARGET": target.label}
    for command in filter(None, (target.then, extra)):
        code = subprocess.run(command, shell=True, env=env).returncode
        if code != 0:
            raise Fail(s.t("then_failed", code=code))


# ---------------------------------------------------------------- dialog

OSASCRIPT = """
on run argv
  set dialogIcon to note
  try
    set dialogIcon to alias POSIX file "/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/LockedIcon.icns"
  end try
  tell application "System Events"
    activate
    set r to display dialog (item 1 of argv) default answer "" with hidden answer ¬
      with title (item 2 of argv) buttons {item 3 of argv, item 4 of argv} ¬
      default button (item 4 of argv) cancel button (item 3 of argv) ¬
      giving up after ((item 5 of argv) as integer) with icon dialogIcon
  end tell
  if gave up of r then return ""
  return text returned of r
end run"""


def prompt_secret(name: str, text: str, s: Settings) -> str:
    title, timeout = s.t("title"), s.timeout
    try:
        if s.prompter:
            env = {**os.environ, "SECRET_DROP_NAME": name, "SECRET_DROP_PROMPT": text}
            out = subprocess.run(s.prompter, shell=True, env=env, capture_output=True, text=True, timeout=timeout)
        elif shutil.which("osascript"):
            args = ["osascript", "-", text, title, s.t("cancel"), s.t("save"), str(timeout)]
            out = subprocess.run(args, input=OSASCRIPT, capture_output=True, text=True, timeout=timeout + 30)
        elif shutil.which("zenity"):
            args = ["zenity", "--entry", "--hide-text", "--title", title, "--text", text, "--timeout", str(timeout)]
            out = subprocess.run(args, capture_output=True, text=True, timeout=timeout + 30)
        elif shutil.which("kdialog"):
            args = ["kdialog", "--title", title, "--password", text]
            out = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        else:
            raise Fail(s.t("no_prompter"))
    except subprocess.TimeoutExpired:
        return ""
    if out.returncode != 0:
        return ""
    value = out.stdout.strip()
    if any(c in value for c in "\r\n\x00"):
        raise Fail(s.t("multiline"))
    return value


# ---------------------------------------------------------------- commands


def cmd_ask(args: argparse.Namespace, s: Settings) -> None:
    check_name(args.name, s)
    target = resolve_target(args.target, s)
    preflight(target, s)
    text = s.t("paste", name=args.name) + (f"\n\n{args.note}" if args.note else "")
    value = prompt_secret(args.name, text, s)
    if not value:
        raise Fail(s.t("cancelled"))
    write_values(target, {args.name: value}, s)
    print(s.t("written", name=args.name, target=target.label, length=len(value)), flush=True)
    run_then(target, args.then, [args.name], s)


def consent(client_id: str, client_secret: str, scope: str, open_browser: bool, s: Settings) -> dict:
    state = secrets.token_urlsafe(24)
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    result: dict[str, str] = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802
            url = urllib.parse.urlparse(self.path)
            query = {k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()}
            if url.path != "/" or not secrets.compare_digest(query.get("state", ""), state):
                self.send_response(404)
                self.end_headers()
                return
            result.update(query)
            ok = "code" in result
            body = (s.t("consent_ok") if ok else s.t("consent_failed", error=result.get("error", "?"))).encode()
            self.send_response(200)
            self.send_header("content-type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_):
            pass

    # Binding port 0 directly avoids the race of picking a free port and binding it later.
    with http.server.HTTPServer(("127.0.0.1", 0), Handler) as server:
        redirect = f"http://127.0.0.1:{server.server_address[1]}"
        url = GOOGLE_AUTH_URL + "?" + urllib.parse.urlencode({
            "client_id": client_id,
            "redirect_uri": redirect,
            "response_type": "code",
            "scope": scope,
            "access_type": "offline",
            "prompt": "consent select_account",
            "state": state,
            "code_challenge": challenge,
            "code_challenge_method": "S256",
        })
        if open_browser:
            print(s.t("browser"), flush=True)
            webbrowser.open(url)
        else:
            print(s.t("auth_url_hint"), flush=True)
            print(f"AUTH_URL {url}", flush=True)
        deadline = time.monotonic() + s.timeout
        while "code" not in result and "error" not in result:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise Fail(s.t("oauth_timeout"))
            server.timeout = remaining
            server.handle_request()
    if "code" not in result:
        raise Fail(s.t("oauth_denied", error=result.get("error")))

    data = urllib.parse.urlencode({
        "code": result["code"],
        "client_id": client_id,
        "client_secret": client_secret,
        "redirect_uri": redirect,
        "grant_type": "authorization_code",
        "code_verifier": verifier,
    }).encode()
    try:
        with urllib.request.urlopen(GOOGLE_TOKEN_URL, data=data, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            error = json.load(e).get("error", e.code)
        except ValueError:
            error = e.code
        raise Fail(s.t("token_error", error=error)) from None


def cmd_google_oauth(args: argparse.Namespace, s: Settings) -> None:
    check_name(args.prefix, s)
    target = resolve_target(args.target, s)
    preflight(target, s)
    id_name, secret_name, token_name = (f"{args.prefix}_{n}" for n in ("CLIENT_ID", "CLIENT_SECRET", "REFRESH_TOKEN"))
    if args.reuse_secret:
        client_secret = read_value(target, secret_name, s)
        if not client_secret:
            raise Fail(s.t("reuse_missing", name=secret_name, target=target.label))
    else:
        client_secret = prompt_secret(secret_name, s.t("oauth_secret", prefix=args.prefix), s)
        if not client_secret:
            raise Fail(s.t("cancelled"))
    token = consent(args.client_id, client_secret, args.scope, not args.no_open, s)
    if "refresh_token" not in token:
        raise Fail(s.t("no_refresh"))
    values = {id_name: args.client_id, secret_name: client_secret, token_name: token["refresh_token"]}
    write_values(target, values, s)
    print(s.t("oauth_done", prefix=args.prefix, target=target.label, scope=token.get("scope", args.scope)), flush=True)
    run_then(target, args.then, list(values), s)


def cmd_targets(_: argparse.Namespace, s: Settings) -> None:
    if not s.aliases:
        print(s.t("no_targets", path=s.config_path))
        return
    for name, conf in sorted(s.aliases.items()):
        line = f"@{name}\t{conf.get('target', '?')}"
        print(line + (f"\tthen: {conf['then']}" if conf.get("then") else ""))


TARGET_HELP = "file:<path> | ssh:<host>:<path> | keychain:<service> | exec:<command> | @<configured name>"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="secret-drop",
        description="Hand a secret to its destination through a native dialog, without pasting it into a chat.",
    )
    parser.add_argument("--version", action="version", version=f"secret-drop {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    ask = sub.add_parser("ask", help="ask for one secret and write it to a target")
    ask.add_argument("name", help="variable name, e.g. STRIPE_SECRET_KEY")
    ask.add_argument("target", help=TARGET_HELP)
    ask.add_argument("note", nargs="?", default="", help="hint shown in the dialog (where to find the value)")
    ask.add_argument("--then", help="shell command to run after a successful write (never sees the value)")
    ask.set_defaults(func=cmd_ask)

    oauth = sub.add_parser("google-oauth", help="run a Google OAuth consent flow and store the refresh token")
    oauth.add_argument("prefix", help="writes <PREFIX>_CLIENT_ID, _CLIENT_SECRET and _REFRESH_TOKEN")
    oauth.add_argument("client_id")
    oauth.add_argument("scope", help="space-separated scopes, quoted")
    oauth.add_argument("target", help=TARGET_HELP)
    oauth.add_argument("--no-open", action="store_true", help="print the consent URL instead of opening it")
    oauth.add_argument("--reuse-secret", action="store_true",
                       help="read <PREFIX>_CLIENT_SECRET back from the target instead of asking")
    oauth.add_argument("--then", help="shell command to run after a successful write (never sees the values)")
    oauth.set_defaults(func=cmd_google_oauth)

    targets = sub.add_parser("targets", help="list the targets defined in the config file")
    targets.set_defaults(func=cmd_targets)

    args = parser.parse_args(argv)
    try:
        settings = load_settings()
        args.func(args, settings)
    except Fail as e:
        print(f"secret-drop: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
