# ---------------------------------------------------------------- run: use secrets, scrub output

SECRET_NAME_RE = re.compile(r"KEY|TOKEN|SECRET|PASS|PW|PRIVATE|CREDENTIAL|AUTH|DSN|COOKIE|SESSION|SIGN|SALT|CERT", re.I)
ENV_LINE_RE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$")
HARMLESS_WORDS = {"true", "false", "yes", "no", "on", "off", "null", "none", "production", "development", "staging",
                  "test", "testing", "local", "localhost", "debug", "info", "warn", "warning", "error", "dev", "prod"}
# Well-known credential shapes, redacted even when secret-drop was never told about them.
SHAPES = [
    (re.compile(rb"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"), b"aws-access-key-id"),
    (re.compile(rb"\bgh[pousr]_[A-Za-z0-9]{36,}"), b"github-token"),
    (re.compile(rb"\bgithub_pat_[A-Za-z0-9_]{22,}"), b"github-token"),
    (re.compile(rb"\bglpat-[A-Za-z0-9_\-]{20,}"), b"gitlab-token"),
    (re.compile(rb"\bxox[abprs]-[A-Za-z0-9\-]{10,}"), b"slack-token"),
    (re.compile(rb"\bAIza[0-9A-Za-z_\-]{35}"), b"google-api-key"),
    (re.compile(rb"\bya29\.[0-9A-Za-z_\-]{20,}"), b"google-access-token"),
    (re.compile(rb"\b1//0[0-9A-Za-z_\-]{30,}"), b"google-refresh-token"),
    (re.compile(rb"\bsk-ant-[A-Za-z0-9_\-]{20,}"), b"anthropic-key"),
    (re.compile(rb"\bsk-(?:proj-)?[A-Za-z0-9_\-]{20,}"), b"openai-key"),
    (re.compile(rb"\b[rs]k_(?:live|test)_[0-9A-Za-z]{16,}"), b"stripe-key"),
    (re.compile(rb"\beyJ[A-Za-z0-9_\-]{8,}\.eyJ[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{8,}"), b"jwt"),
]
# Openings of those shapes: a token at the end of a partial write that starts like this is held back.
SHAPE_STARTS = (b"AKIA", b"ASIA", b"gh", b"github_pat_", b"glpat-", b"xox", b"AIza", b"ya29.", b"1//0", b"sk-",
                b"sk_", b"rk_", b"eyJ")
TOKEN_TAIL = re.compile(rb"[A-Za-z0-9_\-./+=:%]+\Z")
PEM_BEGIN = re.compile(rb"-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----")
PEM_END = re.compile(rb"-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----")
PEM_BODY = re.compile(rb"[A-Za-z0-9+/=]*\Z|[A-Za-z-]+: .*\Z")
PEM_MAX_LINES = 200
HOLD_SECONDS = 2.0


def parse_env(text: str) -> dict[str, str]:
    values = {}
    for line in text.splitlines():
        m = ENV_LINE_RE.match(line)
        if not m or line.lstrip().startswith("#"):
            continue
        value = m.group(2).strip()
        if len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1]
        elif len(value) >= 2 and value[0] == value[-1] == '"':
            value = re.sub(r'\\(["\\$`])', r"\1", value[1:-1])
        values[m.group(1)] = value
    return values


def env_line(name: str, value: str) -> str:
    """NAME=value, quoted when dotenv parsers or shells would otherwise change the value."""
    if not re.search(r"[\s#\"'$\\`]", value):
        return f"{name}={value}"
    if "'" not in value:
        return f"{name}='{value}'"
    return f'{name}="' + re.sub(r'(["\\$`])', r"\\\1", value) + '"'


def keychain_value(service: str, name: str) -> str | None:
    out = subprocess.run(["security", "find-generic-password", "-s", service, "-a", name, "-w"],
                         capture_output=True, text=True)
    return out.stdout.rstrip("\n") if out.returncode == 0 else None


def load_env_file(path: str, s: Settings) -> tuple[dict[str, str], set[str]]:
    """Reads KEY=value lines literally (never as shell code) and resolves keychain: references.
    Returns the values and the names that came from the keychain."""
    with open(os.path.expanduser(path), encoding="utf-8") as f:
        values = parse_env(f.read())
    from_keychain = set()
    for name, value in values.items():
        if value.startswith("keychain:"):
            resolved = keychain_value(value[len("keychain:"):], name)
            if resolved is None:
                raise Fail(s.t("missing_ref", name=name, service=value[len("keychain:"):]))
            values[name] = resolved
            from_keychain.add(name)
    return values, from_keychain


def harmless(name: str, value: str) -> bool:
    """Values that are clearly configuration, not secrets: numbers, booleans, common words, plain URLs."""
    if not value:
        return True
    if SECRET_NAME_RE.search(name):
        return False
    return bool(len(value) <= 3 or re.fullmatch(r"-?\d+(?:\.\d+)?", value) or value.lower() in HARMLESS_WORDS
                or re.fullmatch(r"https?://[^@\s?#]+", value))


def encodings(value: str) -> list[bytes]:
    """The value as it may appear in output: raw, URL-encoded and base64 at every byte alignment."""
    raw = value.encode()
    forms = [raw, urllib.parse.quote(value, safe="").encode(), urllib.parse.quote_plus(value).encode()]
    for encode in (base64.b64encode, base64.urlsafe_b64encode):
        for pad in range(3):
            encoded = encode(b"\0" * pad + raw)
            start = (pad * 4 + 2) // 3  # characters that also depend on the bytes before the value
            stop = ((pad + len(raw)) * 4) // 3  # characters fully determined by the value
            forms.append(encoded[start:stop])
    return [f for f in forms if len(f) >= 6]


class Scrubber:
    """Replaces known secret values (raw, base64, URL-encoded) and well-known key shapes in output."""

    def __init__(self, secrets_by_name: dict[str, str]):
        self.forms: dict[bytes, bytes] = {}
        for name, value in secrets_by_name.items():
            for form in encodings(value):
                self.forms.setdefault(form, b"[redacted:" + name.encode() + b"]")
        ordered = sorted(self.forms, key=len, reverse=True)
        self.pattern = re.compile(b"|".join(re.escape(f) for f in ordered)) if ordered else None
        self.in_pem: dict[int, int] = {}  # stream -> lines swallowed so far inside a private key block

    def text(self, data: bytes) -> bytes:
        if self.pattern:
            data = self.pattern.sub(lambda m: self.forms[m.group(0)], data)
        for shape, label in SHAPES:
            data = shape.sub(b"[redacted:" + label + b"]", data)
        return data

    def line(self, stream: int, data: bytes) -> bytes:
        if stream in self.in_pem:
            self.in_pem[stream] += 1
            if PEM_END.search(data) or self.in_pem[stream] > PEM_MAX_LINES:
                del self.in_pem[stream]
                return b""
            if PEM_BODY.match(data.strip()):
                return b""  # base64 body or armor header of the key
            del self.in_pem[stream]  # an ordinary line: the block was cut short, carry on
        begin = PEM_BEGIN.search(data)
        if begin:
            if not PEM_END.search(data, begin.end()):
                self.in_pem[stream] = 0
            data = data[:begin.start()] + b"[redacted:private-key]" + (b"\n" if data.endswith(b"\n") else b"")
        return self.text(data)

    def unsafe_tail(self, data: bytes) -> int:
        """How many trailing bytes could be the start of a secret, so they must wait for more output."""
        hold = 0
        for form in self.forms:
            for k in range(min(len(form) - 1, len(data)), hold, -1):
                if data.endswith(form[:k]):
                    hold = k
                    break
        token = TOKEN_TAIL.search(data[-4096:])
        if token and any(token.group(0).startswith(s) or s.startswith(token.group(0)) for s in SHAPE_STARTS):
            hold = max(hold, len(token.group(0)))
        return hold


def pump(proc: subprocess.Popen, scrubber: Scrubber) -> None:
    """Streams the child's stdout/stderr through the scrubber. Only whole lines are released right
    away; a partial line is released once nothing in it could still grow into a secret."""
    outputs = {proc.stdout.fileno(): sys.stdout.buffer, proc.stderr.fileno(): sys.stderr.buffer}
    buffers = {fd: b"" for fd in outputs}
    held_since: dict[int, float] = {}
    sel = selectors.DefaultSelector()
    for fd in outputs:
        sel.register(fd, selectors.EVENT_READ)

    def emit(fd: int, data: bytes) -> None:
        if data:
            try:
                outputs[fd].write(data)
                outputs[fd].flush()
            except BrokenPipeError:  # e.g. `secret-drop run ... | head -1`: drop the rest quietly
                devnull = os.open(os.devnull, os.O_WRONLY)
                os.dup2(devnull, outputs[fd].fileno())
                os.close(devnull)

    def release_partial(fd: int, force: bool) -> None:
        data = buffers[fd]
        keep = 0 if force else scrubber.unsafe_tail(data)
        if keep and len(data) > 65536 + 4096:
            keep = min(keep, 4096)
        emit(fd, scrubber.line(fd, data[:len(data) - keep]))
        buffers[fd] = data[len(data) - keep:]
        if buffers[fd]:
            held_since.setdefault(fd, time.monotonic())
        else:
            held_since.pop(fd, None)

    quiet_after_exit = 0.0
    while sel.get_map():
        events = sel.select(timeout=0.2)
        now = time.monotonic()
        if not events:
            for fd in list(buffers):
                if buffers[fd]:
                    release_partial(fd, force=now - held_since.get(fd, now) > HOLD_SECONDS)
            if proc.poll() is not None:  # child is gone; don't wait on its background processes
                quiet_after_exit += 0.2
                if quiet_after_exit >= 0.4:
                    break
            continue
        quiet_after_exit = 0.0
        for key, _ in events:
            fd = key.fd
            chunk = os.read(fd, 65536)
            if not chunk:
                sel.unregister(fd)
                release_partial(fd, force=True)
                continue
            buffers[fd] += chunk
            lines = buffers[fd].split(b"\n")
            buffers[fd] = lines.pop()
            emit(fd, b"".join(scrubber.line(fd, line + b"\n") for line in lines))
            if len(buffers[fd]) > 65536:
                release_partial(fd, force=False)
    for fd in buffers:
        release_partial(fd, force=True)


def run_scrubbed(command: list[str] | str, env: dict[str, str], scrubber: Scrubber) -> int:
    try:
        proc = subprocess.Popen(command, env=env, shell=isinstance(command, str),
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise Fail(f"{command[0]}: command not found", 127) from None
    previous = signal.signal(signal.SIGTERM, lambda *_: proc.terminate())
    try:
        pump(proc, scrubber)
        code = proc.wait()
    finally:
        signal.signal(signal.SIGTERM, previous)
    return 128 - code if code < 0 else code


def cmd_run(args: argparse.Namespace, s: Settings) -> int:
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        raise Fail(s.t("run_no_command"), 2)
    values: dict[str, str] = {}
    secret_names: set[str] = set()
    for path in args.env_file:
        loaded, from_keychain = load_env_file(path, s)
        values.update(loaded)
        secret_names |= from_keychain
        if os.path.realpath(os.path.expanduser(path)) in registered_files(s):
            secret_names |= set(loaded)  # everything in a file secret-drop wrote to counts as secret
    scrubber = Scrubber({k: v for k, v in values.items() if k in secret_names or not harmless(k, v)})
    signal.signal(signal.SIGINT, signal.SIG_IGN)  # the child gets Ctrl-C from the terminal itself
    return run_scrubbed(command, {**os.environ, **values}, scrubber)


