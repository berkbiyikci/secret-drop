class Fail(Exception):
    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


@dataclass
class Settings:
    lang: str
    timeout: int
    prompter: str | None
    config_path: str
    aliases: dict[str, dict[str, str]]
    protect: list[str]
    allow: list[str]

    def t(self, key: str, **kw) -> str:
        return MESSAGES[self.lang][key].format(**kw)


@dataclass
class Target:
    label: str  # what the user typed, shown in output
    kind: str  # file | ssh | keychain | exec
    location: str  # path, remote path, keychain service or shell command
    host: str = ""
    then: str = ""
    ref: str = ""


# ---------------------------------------------------------------- settings


def detect_lang(configured: str | None) -> str:
    for candidate in (os.environ.get("SECRET_DROP_LANG"), configured,
                      os.environ.get("LC_ALL"), os.environ.get("LC_MESSAGES"), os.environ.get("LANG")):
        if candidate:
            return "tr" if candidate.lower().startswith("tr") else "en"
    if sys.platform == "darwin":
        out = subprocess.run(["defaults", "read", "-g", "AppleLanguages"], capture_output=True, text=True)
        first = re.search(r'"?([A-Za-z-]+)"?', out.stdout.split("(", 1)[-1])
        if first and first.group(1).lower().startswith("tr"):
            return "tr"
    return "en"


def load_settings() -> Settings:
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    path = os.environ.get("SECRET_DROP_CONFIG") or os.path.join(config_home, "secret-drop", "config")
    parser = configparser.ConfigParser(interpolation=None, inline_comment_prefixes=(";", "#"))
    parser.read(path, encoding="utf-8")
    base = parser["settings"] if parser.has_section("settings") else {}
    aliases = {
        section.split(".", 1)[1]: dict(parser[section])
        for section in parser.sections()
        if section.startswith("target.")
    }
    timeout = int(os.environ.get("SECRET_DROP_TIMEOUT") or base.get("timeout") or DEFAULT_TIMEOUT)
    prompter = os.environ.get("SECRET_DROP_PROMPTER") or base.get("prompter") or None
    guard = parser["guard"] if parser.has_section("guard") else {}
    globs = lambda key: [g.strip() for g in guard.get(key, "").split(",") if g.strip()]  # noqa: E731
    return Settings(detect_lang(base.get("lang")), timeout, prompter, path, aliases, globs("protect"), globs("allow"))


def registry_path(s: Settings) -> str:
    """Local files secret-drop has written secrets to; the guard protects them."""
    return os.path.join(os.path.dirname(s.config_path), "protected")


def registered_files(s: Settings) -> set[str]:
    try:
        with open(registry_path(s), encoding="utf-8") as f:
            return {line.strip() for line in f if line.strip()}
    except FileNotFoundError:
        return set()


def register_file(path: str, s: Settings) -> None:
    files = registered_files(s)
    if path not in files:
        os.makedirs(os.path.dirname(registry_path(s)), exist_ok=True)
        with open(registry_path(s), "a", encoding="utf-8") as f:
            f.write(path + "\n")


# ---------------------------------------------------------------- targets


def check_name(name: str, s: Settings) -> None:
    if not NAME_RE.match(name):
        raise Fail(s.t("bad_name", name=name), 2)


def resolve_target(spec: str, s: Settings) -> Target:
    if ":" not in spec and not spec.startswith("@") and spec not in s.aliases and (
            "/" in spec or spec.startswith(".") or os.path.exists(spec)):
        spec = f"file:{spec}"  # a bare path such as .env means a local file
    alias = spec[1:] if spec.startswith("@") else (spec if ":" not in spec else None)
    if alias is not None:
        if alias not in s.aliases or "target" not in s.aliases[alias]:
            raise Fail(s.t("unknown_target", target=spec), 2)
        conf = s.aliases[alias]
        inner = resolve_target(conf["target"], s)
        ref = os.path.expanduser(conf.get("ref", ""))
        return Target(f"@{alias}", inner.kind, inner.location, inner.host, conf.get("then", ""), ref)
    kind, _, rest = spec.partition(":")
    if kind == "ssh":
        host, sep, path = rest.partition(":")
        if host and sep and path:
            return Target(spec, "ssh", path, host)
    elif kind in ("file", "keychain", "exec") and rest:
        location = os.path.expanduser(rest) if kind == "file" else rest
        return Target(spec, kind, location)
    raise Fail(s.t("unknown_target", target=spec), 2)


def preflight(target: Target, s: Settings) -> None:
    """Fail before the dialog opens, so nobody pastes a secret into a dead end."""
    for path in filter(None, (target.location if target.kind == "file" else "", target.ref)):
        parent = os.path.dirname(os.path.abspath(path))
        if not os.path.isdir(parent):
            raise Fail(s.t("no_dir", path=parent))
    if target.kind == "file" and git_tracked(target.location):
        raise Fail(s.t("tracked", path=target.location))
    if target.kind == "keychain" and sys.platform != "darwin":
        raise Fail(s.t("keychain_macos"))
    elif target.kind == "ssh":
        ssh(target.host, "true", s)


def git(args: list[str], cwd: str) -> subprocess.CompletedProcess | None:
    if not shutil.which("git"):
        return None
    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)


def git_tracked(path: str) -> bool:
    path = os.path.realpath(path)
    out = git(["ls-files", "--error-unmatch", "--", os.path.basename(path)], os.path.dirname(path))
    return bool(out and out.returncode == 0)


def ensure_gitignored(path: str, s: Settings) -> str:
    """Adds a secret file to its repo's .gitignore so it cannot be committed by accident."""
    path = os.path.realpath(path)
    cwd = os.path.dirname(path)
    root = git(["rev-parse", "--show-toplevel"], cwd)
    if not root or root.returncode != 0 or git(["check-ignore", "-q", path], cwd).returncode == 0:
        return ""
    top = os.path.realpath(root.stdout.strip())
    rel = os.path.relpath(path, top).replace(os.sep, "/")
    gitignore = os.path.join(top, ".gitignore")
    try:
        with open(gitignore, encoding="utf-8") as f:
            existing = f.read()
    except FileNotFoundError:
        existing = ""
    with open(gitignore, "a", encoding="utf-8") as f:
        f.write(("\n" if existing and not existing.endswith("\n") else "") + f"/{rel}\n")
    return s.t("gitignored", path=rel, gitignore=os.path.relpath(gitignore))


def clear_clipboard(values: list[str]) -> bool:
    """Empties the clipboard if it still holds a value that was just stored."""
    if sys.platform != "darwin" or not shutil.which("pbpaste"):
        return False
    current = subprocess.run(["pbpaste"], capture_output=True, text=True).stdout.strip()
    if current and current in values:
        subprocess.run(["pbcopy"], input="", text=True)
        return True
    return False


def deliver(target: Target, values: dict[str, str], s: Settings) -> tuple[str, list[str]]:
    """Writes values to the target and tidies up; returns (target label, extra lines to print)."""
    write_values(target, values, s)
    notes = []
    if target.kind == "file":
        register_file(os.path.realpath(target.location), s)
        notes.append(ensure_gitignored(target.location, s))
    label = target.label
    if target.ref:
        write_env_file(target.ref, {name: f"keychain:{target.location}" for name in values})
        label = s.t("ref_label", target=target.label, ref=target.ref)
    return label, [n for n in notes if n]


def ssh(host: str, script: str, s: Settings, stdin: str = "") -> str:
    out = subprocess.run([*SSH, host, script], input=stdin, capture_output=True, text=True)
    if out.returncode != 0:
        sys.stderr.write(out.stderr)
        raise Fail(s.t("ssh_failed", host=host, code=out.returncode))
    return out.stdout


def remote_path(path: str) -> str:
    if path.startswith("~/"):
        return '"$HOME"/' + shlex.quote(path[2:])
    return shlex.quote(path)


def write_values(target: Target, values: dict[str, str], s: Settings) -> None:
    if target.kind == "file":
        write_env_file(target.location, values)
    elif target.kind == "ssh":
        names = "|".join(values)  # names are validated, safe inside the pattern
        script = (
            f"set -eu; umask 077; f={remote_path(target.location)}; "
            'new=$(mktemp "$f.secret-drop.XXXXXX"); trap \'rm -f "$new"\' EXIT; '
            f"if [ -f \"$f\" ]; then grep -v -E '^({names})=' \"$f\" > \"$new\" || [ $? -eq 1 ]; fi; "
            'cat >> "$new"; chmod 600 "$new"; mv "$new" "$f"; trap - EXIT'
        )
        ssh(target.host, script, s, stdin="".join(f"{k}={v}\n" for k, v in values.items()))
    elif target.kind == "keychain":
        for name, value in values.items():
            # `security -i` reads the command from stdin, so the value never reaches argv.
            command = f"add-generic-password -U -s {shlex.quote(target.location)} -a {name} -X {value.encode().hex()}\n"
            subprocess.run(["security", "-i"], input=command, capture_output=True, text=True)
            check = subprocess.run(["security", "find-generic-password", "-s", target.location, "-a", name],
                                   capture_output=True)
            if check.returncode != 0:
                raise Fail(s.t("keychain_failed", name=name))
    elif target.kind == "exec":
        for name, value in values.items():
            env = {**os.environ, "SECRET_DROP_NAME": name}
            # stdout is discarded so a careless command cannot echo the value back to the agent.
            out = subprocess.run(target.location, shell=True, input=value, env=env, text=True,
                                 stdout=subprocess.DEVNULL)
            if out.returncode != 0:
                raise Fail(s.t("exec_failed", name=name, code=out.returncode))


def write_env_file(path: str, values: dict[str, str]) -> None:
    path = os.path.realpath(path)
    try:
        with open(path, encoding="utf-8") as f:
            lines = [line for line in f.read().splitlines() if line.split("=", 1)[0] not in values]
    except FileNotFoundError:
        lines = []
    lines += [f"{k}={v}" for k, v in values.items()]
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".secret-drop-")  # created 0600
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n")
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)
        raise


def read_value(target: Target, name: str, s: Settings) -> str:
    if target.kind == "file":
        try:
            with open(target.location, encoding="utf-8") as f:
                found = [line.split("=", 1)[1] for line in f.read().splitlines() if line.startswith(f"{name}=")]
        except FileNotFoundError:
            found = []
        return found[-1] if found else ""
    if target.kind == "ssh":
        script = f"[ -f {remote_path(target.location)} ] && sed -n 's/^{name}=//p' {remote_path(target.location)} | tail -n 1 || true"
        return ssh(target.host, script, s).strip()
    if target.kind == "keychain":
        out = subprocess.run(["security", "find-generic-password", "-s", target.location, "-a", name, "-w"],
                             capture_output=True, text=True)
        return out.stdout.strip() if out.returncode == 0 else ""
    raise Fail(s.t("reuse_unsupported"), 2)


def run_then(target: Target, extra: str | None, names: list[str], s: Settings) -> None:
    env = {**os.environ, "SECRET_DROP_NAMES": " ".join(names), "SECRET_DROP_TARGET": target.label}
    for command in filter(None, (target.then, extra)):
        code = subprocess.run(command, shell=True, env=env).returncode
        if code != 0:
            raise Fail(s.t("then_failed", code=code))


